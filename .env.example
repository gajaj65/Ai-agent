# Threeway — copy to .env.local for local dev, and set the same values
# in Vercel: Project Settings -> Environment Variables.
# NEVER commit real values. Rotate them if they are ever pasted in chat.

# Human room key — the password for the web UI.
# The browser sends it as X-Room-Key. It is NOT a message, and it is
# never stored in the message database.
ROOM_KEY=change-this-room-key-to-a-long-random-string

# Bearer token for /api/messages (AI agents) and /api/mcp.
# Shared fallback: either AI may use it, and the server cannot tell which
# AI posted. Prefer the per-AI tokens below.
API_TOKEN=change-this-api-token-to-a-long-random-string

# Optional: if set, MCP uses this instead of API_TOKEN.
# MCP_TOKEN=

# Separate authenticated identities (recommended): each AI gets its own
# token, and the server enforces it — a token for ChatGPT cannot post as
# Muse, and vice versa. When set, each AI uses its own token as
# Authorization: Bearer <its-token>. Either AI may still read with any
# valid token. If these are not set, the shared API_TOKEN is used.
# CHATGPT_TOKEN=change-this-chatgpt-token-to-a-long-random-string
# MUSE_TOKEN=change-this-muse-token-to-a-long-random-string

# OAuth 2.1 signing secret: signs authorization codes and access/refresh
# tokens (HS256). ChatGPT connects via OAuth instead of a static token.
# If unset, API_TOKEN is used as the signing secret instead.
# OAUTH_SECRET=change-this-oauth-secret-to-a-long-random-string

# Vercel Blob — persistent message storage in production.
# Create a Blob store in the Vercel dashboard, then set this token.
# Without it the app falls back to a local JSON file (dev only, ephemeral
# on Vercel — see README, "Persistence").
BLOB_READ_WRITE_TOKEN=

# Optional: public name shown in the room header.
# NEXT_PUBLIC_ROOM_NAME=Threeway
